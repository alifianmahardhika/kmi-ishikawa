# Dev flag: when "dev", the app + functions use a local SQLite file instead of Turso.
APP_ENV=dev

# Gate for scripts/migrate-db.ts run via `bun run build` (Netlify deploys) — leave unset
# normally to avoid an extra Turso round-trip on every deploy. Set to "true" only for the
# deploy that should apply new migrations, then unset it again. Not needed locally —
# `bun run migrate` always forces the run regardless of this variable.
RUN_MIGRATIONS=

# Turso / libSQL (production). Leave empty for local dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin auth
# Generate with: bun scripts/hash-password.ts 'your-password'
ADMIN_PASSWORD_HASH=
# Random long string used to sign the admin session cookie.
# Generate with: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=
# Random long string mixed into IP hashing so hashes aren't reversible/rainbow-table-able.
IP_SALT=
